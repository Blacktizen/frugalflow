{
  "about": "The 13 probes of the old delegation guard, translated for guard_hook.py. Each probe runs in its own fresh FRUGALFLOW_HOME. In every string, {home} is replaced by that folder and {now} by the current local time (ISO). files: name -> [text, repeat], written as text * repeat under {home}. log: the lines of {home}/delegations.jsonl. expect and old: deny or allow.",
  "settings": {
    "code_extensions": [".py"],
    "line_threshold": 3,
    "receipt_minutes": 60,
    "quarantine_minutes": 60,
    "intake_max_lines": 400,
    "intake_max_bytes": 60000,
    "delegate_tools": [],
    "fix_hint": "delegate it.",
    "delegation_logs": ["delegations.jsonl"],
    "audit_log": "audit.jsonl"
  },
  "probes": [
    {"id": 1, "name": "write a code file (Write)", "old": "deny", "expect": "deny",
     "files": {}, "log": [],
     "call": {"tool_name": "Write", "tool_input": {"file_path": "{home}/probe.py", "content": "print('hello')\nprint('hello')\nprint('hello')\nprint('hello')\nprint('hello')\nprint('hello')\nprint('hello')\nprint('hello')\nprint('hello')\nprint('hello')\n"}}},
    {"id": 2, "name": "write code through Bash (heredoc)", "old": "deny", "expect": "deny",
     "files": {}, "log": [],
     "call": {"tool_name": "Bash", "tool_input": {"command": "cat > {home}/probe.py <<EOF\nprint('test')\nEOF"}}},
    {"id": 3, "name": "ordinary read (Bash ls)", "old": "allow", "expect": "allow",
     "files": {}, "log": [],
     "call": {"tool_name": "Bash", "tool_input": {"command": "ls -la"}}},
    {"id": 4, "name": "write a note (.md)", "old": "allow", "expect": "allow",
     "files": {}, "log": [],
     "call": {"tool_name": "Write", "tool_input": {"file_path": "{home}/probe.md", "content": "Note content"}}},
    {"id": 5, "name": "read a delegated product (Read)", "old": "deny", "expect": "deny",
     "files": {"q.py": ["print('q')\n", 2]},
     "log": [{"time": "{now}", "status": "success", "model_answered": "probe", "target": "{home}/q.py", "sha256": "x"}],
     "call": {"tool_name": "Read", "tool_input": {"file_path": "{home}/q.py"}}},
    {"id": 6, "name": "read a delegated product (cat)", "old": "deny", "expect": "deny",
     "files": {"q.py": ["print('q')\n", 2]},
     "log": [{"time": "{now}", "status": "success", "model_answered": "probe", "target": "{home}/q.py", "sha256": "x"}],
     "call": {"tool_name": "Bash", "tool_input": {"command": "cat {home}/q.py"}}},
    {"id": 7, "name": "read a small code file not delegated (Read)", "old": "allow", "expect": "allow",
     "files": {"small.py": ["# not delegated, small enough\nprint('probe')\n", 1]}, "log": [],
     "call": {"tool_name": "Read", "tool_input": {"file_path": "{home}/small.py"}}},
    {"id": 8, "name": "read a big file whole", "old": "deny", "expect": "deny",
     "files": {"big.txt": ["filler line for the intake probe\n", 900]}, "log": [],
     "call": {"tool_name": "Read", "tool_input": {"file_path": "{home}/big.txt"}}},
    {"id": 9, "name": "read the SAME file, targeted", "old": "allow", "expect": "allow",
     "files": {"big.txt": ["filler line for the intake probe\n", 900]}, "log": [],
     "call": {"tool_name": "Read", "tool_input": {"file_path": "{home}/big.txt", "offset": 0, "limit": 20}}},
    {"id": 10, "name": "content matches the delegated receipt", "old": "allow", "expect": "allow",
     "files": {},
     "log": [{"time": "{now}", "status": "success", "model_answered": "probe", "target": "{home}/emp10.py", "sha256": "ae14d586cbe8f7bd4afcc49894aab9f76279ee9715d95bc373e7fac1618e9be3"}],
     "call": {"tool_name": "Write", "tool_input": {"file_path": "{home}/emp10.py", "content": "print(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\nprint(\"a\")\n"}}},
    {"id": 11, "name": "content differs from the delegated one", "old": "deny", "expect": "deny",
     "files": {},
     "log": [{"time": "{now}", "status": "success", "model_answered": "probe", "target": "{home}/emp11.py", "sha256": "ae14d586cbe8f7bd4afcc49894aab9f76279ee9715d95bc373e7fac1618e9be3"}],
     "call": {"tool_name": "Write", "tool_input": {"file_path": "{home}/emp11.py", "content": "print(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\n"}}},
    {"id": 12, "name": "content differs, but the edit is declared", "old": "allow", "expect": "allow",
     "files": {},
     "log": [{"time": "{now}", "status": "success", "model_answered": "probe", "target": "{home}/emp12.py", "sha256": "ae14d586cbe8f7bd4afcc49894aab9f76279ee9715d95bc373e7fac1618e9be3"},
             {"kind": "edit", "time": "{now}", "target": "{home}/emp12.py", "reason": "probe"}],
     "call": {"tool_name": "Write", "tool_input": {"file_path": "{home}/emp12.py", "content": "print(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\n"}}},
    {"id": 13, "name": "old-format receipt, no fingerprint", "old": "deny", "expect": "deny",
     "files": {},
     "log": [{"time": "{now}", "status": "success", "model_answered": "probe", "target": "{home}/emp13.py"}],
     "call": {"tool_name": "Write", "tool_input": {"file_path": "{home}/emp13.py", "content": "print(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\nprint(\"b\")\n"}}}
  ]
}
