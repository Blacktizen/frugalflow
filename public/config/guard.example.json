{
  "code_extensions": [".py", ".sh", ".js", ".ts", ".ipynb", ".tsx", ".jsx", ".go", ".rs", ".rb", ".java", ".kt", ".swift", ".c", ".cc", ".cpp", ".h", ".hpp", ".cs", ".php", ".pl", ".lua", ".mjs", ".cjs", ".zsh", ".bash", ".ps1", ".pyw", ".pyi", ".sql", ".vue", ".svelte", ".mts", ".cts", ".scala", ".dart", ".ex", ".exs", ".erl", ".hs", ".ml", ".jl", ".tf", ".bat", ".cmd", ".fish", ".gradle", ".cmake"],
  "delegation_logs": ["delegations.jsonl"],
  "audit_log": "audit.jsonl",
  "line_threshold": 20,
  "receipt_minutes": 30,
  "quarantine_minutes": 45,
  "read_waiver_minutes": 10,
  "intake_max_lines": 300,
  "intake_max_bytes": 40000,
  "digest_extensions": [".md", ".log", ".txt", ".jsonl"],
  "digest_max_bytes": 70000,
  "digest_waiver": "manual-digest",
  "delegate_tools": ["delegate.py"],
  "fix_hint": "Delegate it: python3 bin/delegate.py --role code --file task.md --out <file>.",
  "checks": ["quarantine_read", "intake", "digest", "reading_gate"],
  "byte_threshold": 2000,
  "cumulative_lines": 60
}