{
  "schema_version": "1",
  "models": [
    {"id": "local-reader", "name": "your-local-model", "location": "local",
     "endpoint": "http://localhost:PORT/v1", "context_window": 16384,
     "paid": false, "trust": "private", "key_env": ""},
    {"id": "remote-coder", "name": "your-remote-model", "location": "remote",
     "endpoint": "https://api.example.com/v1", "context_window": 32768,
     "paid": true, "trust": "untrusted_third_party", "key_env": "FRUGALFLOW_REMOTE_KEY"},
    {"id": "session", "name": "the assistant in session", "location": "in_session",
     "paid": false, "trust": "private", "key_env": ""}
  ],
  "layers": [
    {"name": "bulk_reading", "delegable": true},
    {"name": "code_writing", "delegable": true},
    {"name": "review", "delegable": true},
    {"name": "kept_judgment", "delegable": false}
  ],
  "roles": [
    {"name": "documents", "layer": "bulk_reading", "model": "local-reader"},
    {"name": "code", "layer": "code_writing", "model": "local-reader"},
    {"name": "code_remote", "layer": "code_writing", "model": "remote-coder"},
    {"name": "review", "layer": "review", "model": "session"},
    {"name": "judgment", "layer": "kept_judgment", "model": ""}
  ]
}
